# Claude API key: enables the AI layer (message check, statement). Without it everything runs on rules/templates.
ANTHROPIC_API_KEY=
# Only for an Anthropic-compatible gateway (not needed for the official API)
ANTHROPIC_BASE_URL=
# Gateways may not support the refusal-fallback beta: set to 0 then
QAQPAN_LLM_FALLBACKS=1
# 1 = never call the model, cache only (use on stage)
QAQPAN_DEMO=0
# Optional overrides
QAQPAN_MODEL=claude-opus-5-5
QAQPAN_LLM_TIMEOUT=25
# Public link: only someone who opened /director?key=<value> can drive or reset the demo
QAQPAN_DIRECTOR_KEY=
# Spend guard for live AI calls
QAQPAN_LLM_RPM=20
QAQPAN_LLM_DAILY=500
