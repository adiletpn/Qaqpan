# AI layer via xKiro (https://docs.xkiro.com): message check, police statement, «Спросить Qaqpan».
# Without a key everything runs on rules / templates / offline answers.
XKIRO_API_KEY=
# Free-tier model with image input; best Kazakh among the free models we tested
XKIRO_MODEL=mistralai/mistral-medium-3.5
XKIRO_BASE_URL=https://api.xkiro.com/v1
# 1 = stage mode: message check / statement only from cache (the assistant may still call live, it has an offline fallback)
QAQPAN_DEMO=0
QAQPAN_LLM_TIMEOUT=25
# Public link: only someone who opened /director?key=<value> can drive or reset the demo
QAQPAN_DIRECTOR_KEY=
# Spend guard for live AI calls
QAQPAN_LLM_RPM=20
QAQPAN_LLM_DAILY=500
