# Claude API key: enables the AI layer (message check, statement). Without it everything runs on rules/templates.
ANTHROPIC_API_KEY=
# 1 = never call the model, cache only (use on stage)
QALQAN_DEMO=0
# Optional overrides
QALQAN_MODEL=claude-opus-5-5
QALQAN_LLM_TIMEOUT=25
# Public link: only someone who opened /director?key=<value> can drive or reset the demo
QALQAN_DIRECTOR_KEY=
# Spend guard for live AI calls
QALQAN_LLM_RPM=20
QALQAN_LLM_DAILY=500
